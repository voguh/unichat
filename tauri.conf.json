{
    "$schema": "https://schema.tauri.app/config/2.12.5",
    "productName": "UniChat",
    "identifier": "unichat",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devUrl": "http://localhost:1421",
        "frontendDist": "./webapp/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [],
        "security": {
            "csp": {
                "default-src": ["'self'"],

                "script-src": ["'self'", "'unsafe-inline'"],
                "script-src-elem": ["'self'", "'unsafe-inline'"],
                "script-src-attr": ["'none'"],

                "style-src": ["'self'", "'unsafe-inline'"],
                "style-src-elem": ["'self'", "'unsafe-inline'"],
                "style-src-attr": ["'unsafe-inline'"],

                "img-src": ["'self'", "data:", "http://localhost:9527", "https:"],
                "media-src": ["http://localhost:9527", "https:"],
                "font-src": ["'self'"],
                "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "https:"],
                "frame-src": ["http://localhost:9527"]
            }
        }
    },
    "bundle": {
        "active": true,
        "resources": ["assets/", "icons/", "widgets/", "LICENSE"],
        "targets": ["deb", "rpm", "appimage", "nsis", "msi", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "licenseFile": "./LICENSE",
        "windows": {
            "nsis": {
                "installMode": "both"
            }
        }
    }
}

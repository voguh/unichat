{
    "js/ts.tsdk.path": "${workspaceFolder}/webapp/node_modules/typescript/lib",

    "biome.requireConfiguration": true,
    "biome.configurationPath": "${workspaceFolder}/webapp/biome.json",
    "biome.lsp.bin": "${workspaceFolder}/webapp/node_modules/.bin/biome",

    "rust-analyzer.rustfmt.overrideCommand": ["rustup", "run", "nightly", "rustfmt", "--config-path", "${workspaceFolder}/rustfmt.toml"],

    "[javascript]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[typescript]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[json]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[jsonc]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[css]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" } },
    "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer", "editor.formatOnSave": true, "editor.codeActionsOnSave": { "source.fixAll": "explicit" } },

    "terminal.integrated.env.linux": {
        "TAURI_APP_PATH": "${workspaceFolder}",
        "TAURI_FRONTEND_PATH": "${workspaceFolder}/webapp"
    },
    "terminal.integrated.env.windows": {
        "TAURI_APP_PATH": "${workspaceFolder}",
        "TAURI_FRONTEND_PATH": "${workspaceFolder}/webapp"
    },
    "terminal.integrated.env.osx": {
        "TAURI_APP_PATH": "${workspaceFolder}",
        "TAURI_FRONTEND_PATH": "${workspaceFolder}/webapp"
    },

    "json.schemaDownload.enable": true,
    "json.schemaDownload.trustedDomains": {
        "https://raw.githubusercontent.com/": true,
        "https://schema.tauri.app": true
    }
}

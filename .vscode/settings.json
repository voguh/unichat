{
    "js/ts.tsdk.path": "./webapp/node_modules/typescript/lib",

    "biome.configurationPath": "./webapp/biome.json",
    "biome.lsp.bin": "./webapp/node_modules/.bin/biome",

    "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
    "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
    "[json]": { "editor.defaultFormatter": "biomejs.biome" },
    "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
    "[css]": { "editor.defaultFormatter": "biomejs.biome" },

    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.biome": "always"
    },

    "terminal.integrated.env.linux": {
        "TAURI_APP_PATH": "${workspaceFolder}",
        "TAURI_FRONTEND_PATH": "${workspaceFolder}/webapp"
    },
    "terminal.integrated.env.windows": {
        "TAURI_APP_PATH": "${workspaceFolder}",
        "TAURI_FRONTEND_PATH": "${workspaceFolder}/webapp"
    },
    "terminal.integrated.env.osx": {
        "TAURI_APP_PATH": "${workspaceFolder}",
        "TAURI_FRONTEND_PATH": "${workspaceFolder}/webapp"
    },

    "json.schemaDownload.enable": true,
    "json.schemaDownload.trustedDomains": {
        "https://raw.githubusercontent.com/": true,
        "https://schema.tauri.app": true
    }
}
